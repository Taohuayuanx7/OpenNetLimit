<Window x:Class="NetMeter.LimitedProgramsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="580" Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HintText" Text="" Foreground="#888888" Margin="2,0,0,8"/>

        <DataGrid x:Name="Grid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFBFC"
                  MouseDoubleClick="Grid_MouseDoubleClick"
                  Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColName" Header="" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn x:Name="ColStatus" Header="" Binding="{Binding Status}" Width="70"/>
                <DataGridTextColumn x:Name="ColDown" Header="" Binding="{Binding DownKb}" Width="90"/>
                <DataGridTextColumn x:Name="ColUp" Header="" Binding="{Binding UpKb}" Width="90"/>
                <DataGridTextColumn x:Name="ColTcp" Header="" Binding="{Binding Tcp}" Width="80"/>
                <DataGridTextColumn x:Name="ColUdp" Header="" Binding="{Binding Udp}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="EditButton" Content="" Padding="16,6" Margin="0,0,10,0" Click="Edit_Click"/>
            <Button x:Name="DeleteButton" Content="" Padding="16,6" Margin="0,0,10,0" Click="Delete_Click"/>
            <Button x:Name="CloseButton" Content="" Padding="16,6" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>