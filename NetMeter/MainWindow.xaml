<Window x:Class="NetMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetMeter" Height="680" Width="1080"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="/assets/app.ico"
        Background="#F5F6F8">
    <Window.Resources>
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="Grid" Grid.Row="0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFBFC"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  Sorting="Grid_Sorting"
                  MouseDoubleClick="Grid_MouseDoubleClick"
                  Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColPid" Header="PID" Binding="{Binding Pid}" Width="70"/>
                <DataGridTextColumn x:Name="ColProcess" Header="" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn x:Name="ColTcp" Header="TCP" Binding="{Binding TcpCount}" Width="70" ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn x:Name="ColUdp" Header="UDP" Binding="{Binding UdpCount}" Width="70" ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn x:Name="ColDown" Header="↓ KB/s" Binding="{Binding DownRate, StringFormat={}{0:0.0}}" Width="110" ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn x:Name="ColUp" Header="↑ KB/s" Binding="{Binding UpRate, StringFormat={}{0:0.0}}" Width="110" ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn x:Name="ColDownLimit" Header="" Binding="{Binding DownLimitKb}" Width="95" ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn x:Name="ColUpLimit" Header="" Binding="{Binding UpLimitKb}" Width="95" ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn x:Name="ColTcpLimit" Header="" Binding="{Binding TcpLimit}" Width="85" ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn x:Name="ColUdpLimit" Header="" Binding="{Binding UdpLimit}" Width="85" ElementStyle="{StaticResource NumCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,8,0,0">
            <DockPanel>
                <Button x:Name="ToggleButton" Content="" Padding="16,6" DockPanel.Dock="Right" Click="ToggleButton_Click"/>
                <Button x:Name="LimitedProgramsButton" Content="" Padding="14,6" Margin="0,0,10,0" DockPanel.Dock="Right" Click="LimitedPrograms_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FilterLabel" Text="" Foreground="#666666"/>
                    <TextBox x:Name="FilterBox" Width="160" Margin="6,0,0,0"
                             VerticalContentAlignment="Center"
                             TextChanged="FilterBox_TextChanged"/>
                    <TextBlock x:Name="RefreshLabel" Text="" Foreground="#666666" Margin="14,0,0,0"/>
                    <ComboBox x:Name="RefreshCombo" Width="72" Margin="6,0,0,0" SelectedIndex="1"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="0.5s" Tag="0.5"/>
                        <ComboBoxItem Content="1s" Tag="1"/>
                        <ComboBoxItem Content="2s" Tag="2"/>
                        <ComboBoxItem Content="3s" Tag="3"/>
                        <ComboBoxItem Content="5s" Tag="5"/>
                    </ComboBox>
                    <TextBlock x:Name="LangLabel" Text="" Foreground="#666666" Margin="14,0,0,0"/>
                    <ComboBox x:Name="LangCombo" Width="96" Margin="6,0,0,0" SelectedIndex="0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="LangCombo_SelectionChanged">
                        <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                        <ComboBoxItem Content="繁體中文" Tag="zh-TW"/>
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="한국어" Tag="ko-KR"/>
                        <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                        <ComboBoxItem Content="Español" Tag="es-ES"/>
                        <ComboBoxItem Content="Português" Tag="pt-BR"/>
                        <ComboBoxItem Content="Français" Tag="fr-FR"/>
                        <ComboBoxItem Content="Deutsch" Tag="de-DE"/>
                    </ComboBox>
                    <TextBlock x:Name="StatusText" Text="" Foreground="#1565C0" FontWeight="SemiBold" Margin="14,0,0,0"/>
                    <TextBlock x:Name="BlockedLabel" Text="" Margin="18,0,0,0" Foreground="#666666"/>
                    <TextBlock x:Name="BlockedText" Text="0" Foreground="#C62828"/>
                    <TextBlock x:Name="DroppedLabel" Text="" Margin="12,0,0,0" Foreground="#666666"/>
                    <TextBlock x:Name="DroppedText" Text="0" Foreground="#C62828"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>